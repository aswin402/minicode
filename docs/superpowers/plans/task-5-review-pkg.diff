+    #[test]
+    fn test_parse_goal_command_show() {
+        assert_eq!(parse_goal_command("/goal"), Some(GoalSubcommand::Show));
+        assert_eq!(parse_goal_command("/intent"), Some(GoalSubcommand::Show));
+        assert_eq!(parse_goal_command("/goal   "), Some(GoalSubcommand::Show));
+        assert_eq!(parse_goal_command("/intent   "), Some(GoalSubcommand::Show));
+    }
