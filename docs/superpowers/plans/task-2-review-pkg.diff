 /// Returns true if the tool name indicates a file read operation.
 fn is_read_tool(name: &str) -> bool {
     let n = name.to_ascii_lowercase();
     matches!(n.as_str(), "read_file" | "view_file" | "cat")
         || n.starts_with("read_")
         || n.starts_with("view_")
 }
 
