+
+        let gradient = BlockGradient::new(
+            "Neon Glow",
+            "linear-gradient(90deg, #FF007F 0%, #7F00FF 100%)",
+            vec!["#FF007F".into(), "#7F00FF".into()],
+            vec!["neon".into(), "vibrant".into()],
