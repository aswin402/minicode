+    fn strip_ansi(s: &str) -> String {
+        let mut res = String::new();
+        let mut in_escape = false;
+        for c in s.chars() {
+            if c == '\x1b' {
+                in_escape = true;
+            } else if in_escape {
+                if c == 'm' {
+                    in_escape = false;
+                }
+            } else {
+                res.push(c);
+            }
+        }
+        res
+    }
