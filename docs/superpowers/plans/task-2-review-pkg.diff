+#[derive(Debug, Clone)]
+struct CompactToolMeta {
+    name: String,
+    target_path: Option<String>,
+    query: Option<String>,
+}
+
+fn is_compacted_receipt(content: &str) -> bool {
+    content.starts_with('[')
+        && (content.contains("Use retrieve_observation(id=\"")
+            || content.contains("superseded by")
+            || content.contains("successfully applied,"))
 }
 
